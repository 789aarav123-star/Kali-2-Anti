<%- include('partials/header') %>

<!-- Minimal Navbar for Inner Pages -->
<header class="sticky top-0 z-40 bg-[#0b1329]/90 backdrop-blur-md border-b border-[#d4af37]/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo & Back to Home -->
      <a href="/" class="flex items-center gap-3 shrink-0 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#d4af37] rounded-lg">
        <div class="relative w-12 h-12 shrink-0 rounded-full overflow-hidden border-2 border-[#d4af37] shadow-lg shadow-[#d4af37]/20 group-hover:scale-105 transition-transform duration-300" style="width: 48px; height: 48px; min-width: 48px; min-height: 48px; max-width: 48px; max-height: 48px;">
          <img src="/images/logo_kali.jpg" alt="Kali Hotel & Restaurant Logo" width="48" height="48" class="w-full h-full object-cover" style="width: 48px; height: 48px; object-fit: cover;">
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-wide text-white group-hover:text-[#f7d774] transition-colors">
            Kali Hotel
          </span>
          <span class="text-xs uppercase tracking-widest text-[#d4af37] font-medium">
            &amp; Restaurant · Janakpur
          </span>
        </div>
      </a>

      <!-- Right Nav Actions -->
      <div class="flex items-center gap-3 shrink-0">
        <a href="/" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 hover:text-white border border-slate-700 text-xs font-semibold tracking-wide transition-all">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Back to Home</span>
        </a>

        <a href="tel:<%= restaurant.phoneRaw %>" 
           class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-slate-900 border border-[#d4af37]/40 text-[#f7d774] hover:bg-[#d4af37]/10 text-xs font-semibold transition-all">
          <svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span class="hidden md:inline"><%= restaurant.phone %></span>
          <span class="md:hidden">Call</span>
        </a>

        <a href="https://wa.me/<%= restaurant.whatsappNumber %>?text=Hello%20Kali%20Hotel!%20I%20have%20a%20question%20regarding%20dining." 
           target="_blank" 
           rel="noopener noreferrer"
           class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-gradient-to-r from-[#d4af37] to-[#aa851e] text-[#0b1329] font-bold text-xs uppercase tracking-wider hover:brightness-110 shadow-md shadow-[#d4af37]/20 transition-all">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>

    </div>
  </div>
</header>

<main class="py-16 sm:py-24 relative overflow-hidden">
  
  <!-- Subtle decorative light flare with GPU isolation -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-b from-[#d4af37]/10 to-transparent rounded-full filter blur-3xl pointer-events-none" style="transform: translate3d(-50%, 0, 0); will-change: transform;"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#f7d774] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[#d4af37] font-medium">Privacy Policy &amp; Trackers</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-[#d4af37]/40 text-xs text-[#d4af37] font-semibold uppercase tracking-wider mb-4 shadow-md">
        <span>Transparent Privacy Disclosure</span>
      </div>
      
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-6 leading-tight">
        Privacy Policy &amp; <span class="gold-gradient-text">Tracker Transparency</span>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-3xl">
        At <strong class="text-white"><%= restaurant.name %></strong> (Janakpur Dham, Nepal), we respect your digital privacy. This document outlines how our website operates, what third-party services and trackers are loaded, and how your privacy is protected under Nepal's legal framework.
      </p>

      <!-- Key Guarantees Pill Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8">
        <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 text-center">
          <span class="block text-[#f7d774] font-bold text-sm">Zero Forms</span>
          <span class="text-[11px] text-slate-400">No data collected via forms</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 text-center">
          <span class="block text-[#f7d774] font-bold text-sm">No Ad Pixels</span>
          <span class="text-[11px] text-slate-400">No Meta or Google Ad trackers</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 text-center">
          <span class="block text-[#f7d774] font-bold text-sm">Direct Contact</span>
          <span class="text-[11px] text-slate-400">Direct Call &amp; WhatsApp only</span>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 text-center">
          <span class="block text-[#f7d774] font-bold text-sm">Nepal Law</span>
          <span class="text-[11px] text-slate-400">Privacy Act 2075 Compliant</span>
        </div>
      </div>
    </div>

    <!-- Main Content Articles -->
    <div class="space-y-10">

      <!-- Section 1: Overview & Stance -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl border border-slate-800">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-white mb-4 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-[#d4af37]/20 border border-[#d4af37]/40 text-[#f7d774] text-sm flex items-center justify-center font-bold">1</span>
          <span>Core Principle &amp; Architecture</span>
        </h2>
        
        <div class="text-slate-300 text-sm leading-relaxed space-y-3">
          <p>
            Our website is designed as an informational digital guide for diners exploring Kali Hotel &amp; Restaurant in Janakpur Dham. We do not require account registration, login credentials, or user profile creation.
          </p>
          <div class="p-4 rounded-xl bg-[#0b1329] border border-[#d4af37]/30 text-amber-200/90 text-xs leading-relaxed">
            <strong class="text-[#f7d774] block mb-1">Important Notice on Bookings &amp; Inquiries:</strong>
            We do not host or operate web-based reservation or inquiry forms on this website. To book a private cabin, reserve a table, or order takeaway, customers initiate contact directly via phone call (<a href="tel:<%= restaurant.phoneRaw %>" class="text-white underline font-semibold"><%= restaurant.phone %></a>) or encrypted WhatsApp chat (<a href="https://wa.me/<%= restaurant.whatsappNumber %>" class="text-white underline font-semibold">+977 9854025213</a>). We never store your payment card numbers or sensitive personal records on our web servers.
          </div>
        </div>
      </section>

      <!-- Section 2: Detailed Tracker & Third-Party Disclosure Table -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl border border-[#d4af37]/30">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-white mb-4 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-[#d4af37]/20 border border-[#d4af37]/40 text-[#f7d774] text-sm flex items-center justify-center font-bold">2</span>
          <span>Complete Audit of Trackers &amp; Third-Party Services</span>
        </h2>

        <p class="text-slate-300 text-sm mb-6 leading-relaxed">
          The table below discloses every external service, embedded element, and technical tracker running on or connected to this website:
        </p>

        <!-- Responsive Table Container -->
        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/80">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="bg-slate-900 border-b border-slate-800 text-[#f7d774]">
                <th class="py-3.5 px-4 font-semibold">Service / Provider</th>
                <th class="py-3.5 px-4 font-semibold">Type &amp; Technology</th>
                <th class="py-3.5 px-4 font-semibold">Purpose &amp; Data Collected</th>
                <th class="py-3.5 px-4 font-semibold">User Control / Opt-Out</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80 text-slate-300">
              
              <!-- Google Maps Iframe -->
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="py-4 px-4 font-medium text-white">
                  <div class="font-bold">Google Maps Embed</div>
                  <span class="text-[10px] text-slate-400">Google LLC / Alphabet</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800/50">Embedded Iframe</span>
                  <div class="text-[10px] text-slate-400 mt-1">Cookies: NID, CONSENT, 1P_JAR</div>
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Renders the interactive map showing Kali Hotel's location on Ring Road, Janakpur Dham (<code class="text-amber-300 text-[11px]">PWRG+3JF</code>). Google may collect IP address, device telemetry, and map interaction coordinates.
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Block third-party cookies in browser settings or use content blockers. Subject to <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-[#d4af37] underline">Google Privacy Policy</a>.
                </td>
              </tr>

              <!-- Google Fonts CDN -->
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="py-4 px-4 font-medium text-white">
                  <div class="font-bold">Google Fonts CDN</div>
                  <span class="text-[10px] text-slate-400">Google LLC</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800/50">Content Delivery Network</span>
                  <div class="text-[10px] text-slate-400 mt-1">Cookie-less HTTP requests</div>
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Loads typography (<em class="text-white">Outfit</em> &amp; <em class="text-white">Playfair Display</em>). Client IP address and User-Agent are transmitted to Google font servers to deliver optimized WOFF2 font files.
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Browser cache maintains font assets. No authentication cookies or user profiles are created by Google for font delivery.
                </td>
              </tr>

              <!-- Server Diagnostic Logs (Morgan) -->
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="py-4 px-4 font-medium text-white">
                  <div class="font-bold">Server Diagnostic Logs</div>
                  <span class="text-[10px] text-slate-400">Internal Express / Morgan</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800/50">First-Party Server Logs</span>
                  <div class="text-[10px] text-slate-400 mt-1">No cookies set</div>
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Logs HTTP requests (IP address, method, URL path, response code, response time) solely for server security, DDoS defense, fault diagnosis, and network uptime maintenance.
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Server-side security measure. Logs are transient, purged periodically, and never matched with personal identities or sold to third parties.
                </td>
              </tr>

              <!-- WhatsApp Direct Connect -->
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="py-4 px-4 font-medium text-white">
                  <div class="font-bold">WhatsApp Direct Link</div>
                  <span class="text-[10px] text-slate-400">Meta Platforms, Inc.</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800/50">External Link / Redirection</span>
                  <div class="text-[10px] text-slate-400 mt-1">wa.me protocol</div>
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  When you tap the WhatsApp button, your browser redirects to WhatsApp to start a conversation with Kali Hotel management. Message content is end-to-end encrypted by WhatsApp.
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Subject to your WhatsApp account settings and <a href="https://www.whatsapp.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer" class="text-[#d4af37] underline">WhatsApp Privacy Policy</a>.
                </td>
              </tr>

              <!-- Facebook External Link -->
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="py-4 px-4 font-medium text-white">
                  <div class="font-bold">Facebook Social Link</div>
                  <span class="text-[10px] text-slate-400">Meta Platforms, Inc.</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800/50">Outbound Social Link</span>
                  <div class="text-[10px] text-slate-400 mt-1">HTTP Referrer</div>
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Outbound link to our official Facebook page. Standard browser referrer headers are transmitted when opening the page in Meta's platform.
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  We run <strong>no Facebook Pixel</strong> or retargeting code on this website. Governed by Meta's privacy policy.
                </td>
              </tr>

              <!-- Local Browser State -->
              <tr class="hover:bg-slate-900/40 transition-colors">
                <td class="py-4 px-4 font-medium text-white">
                  <div class="font-bold">Client-Side UI State</div>
                  <span class="text-[10px] text-slate-400">First-Party Browser Memory</span>
                </td>
                <td class="py-4 px-4">
                  <span class="px-2 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800/50">Ephemeral DOM Memory</span>
                  <div class="text-[10px] text-slate-400 mt-1">No cross-site tracking</div>
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Maintains dynamic menu category tab filtering, lightbox modal view state, and mobile navigation open/close states during your active visit.
                </td>
                <td class="py-4 px-4 leading-relaxed">
                  Cleared automatically when you close or reload the browser tab.
                </td>
              </tr>

            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: Cookie Management & Browser Controls -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl border border-slate-800">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-white mb-4 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-[#d4af37]/20 border border-[#d4af37]/40 text-[#f7d774] text-sm flex items-center justify-center font-bold">3</span>
          <span>How to Manage or Block Trackers</span>
        </h2>

        <div class="text-slate-300 text-sm leading-relaxed space-y-4">
          <p>
            You have complete control over whether third-party cookies or scripts are permitted to execute in your web browser. You can block or delete third-party cookies at any time without impacting your ability to browse our menu or view our dishes:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
              <h3 class="font-bold text-white mb-1.5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#d4af37]"></span>
                <span>Google Chrome &amp; Android</span>
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Go to <code class="text-slate-300">Settings &gt; Privacy and security &gt; Third-party cookies</code> and choose &ldquo;Block third-party cookies&rdquo;.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
              <h3 class="font-bold text-white mb-1.5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#d4af37]"></span>
                <span>Apple Safari (iOS &amp; macOS)</span>
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Open <code class="text-slate-300">Settings &gt; Safari &gt; Privacy &amp; Security</code> and enable &ldquo;Prevent Cross-Site Tracking&rdquo; and &ldquo;Block All Cookies&rdquo;.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
              <h3 class="font-bold text-white mb-1.5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#d4af37]"></span>
                <span>Mozilla Firefox</span>
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Navigate to <code class="text-slate-300">Settings &gt; Privacy &amp; Security &gt; Enhanced Tracking Protection</code> and select &ldquo;Strict&rdquo; to block cross-site cookies.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
              <h3 class="font-bold text-white mb-1.5 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#d4af37]"></span>
                <span>Microsoft Edge</span>
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Open <code class="text-slate-300">Settings &gt; Cookies and site permissions</code> and toggle &ldquo;Block third-party cookies&rdquo;.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Legal Framework under Nepal Law -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl border border-slate-800">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-white mb-4 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-[#d4af37]/20 border border-[#d4af37]/40 text-[#f7d774] text-sm flex items-center justify-center font-bold">4</span>
          <span>Compliance with Nepal's Individual Privacy Act, 2075 (2018)</span>
        </h2>

        <div class="text-slate-300 text-sm leading-relaxed space-y-3">
          <p>
            Kali Hotel &amp; Restaurant is an established culinary and hospitality enterprise located in Janakpur Dham, Dhanusha District, Madhesh Province, Nepal. We adhere to the constitutional principles enshrined in the Constitution of Nepal and the <strong>Individual Privacy Act, 2075 (2018)</strong>:
          </p>

          <ul class="space-y-2.5 pt-2 text-xs text-slate-300 list-disc list-inside">
            <li><strong class="text-white">Confidentiality of Customer Inquiries:</strong> Any telephone inquiries or WhatsApp messages initiated by customers regarding cabin bookings, party decorations, or food orders are treated with strict confidentiality.</li>
            <li><strong class="text-white">No Unauthorized Disclosure:</strong> We do not disclose, distribute, or commercialize customer phone numbers, party dates, or guest names to external marketing agencies or third-party aggregators.</li>
            <li><strong class="text-white">Right to Inquire:</strong> Customers have the right to request clarification on any operational notes or order records kept by restaurant management by contacting us directly.</li>
          </ul>
        </div>
      </section>

      <!-- Section 5: Children & Family Dining Privacy -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl border border-slate-800">
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-white mb-4 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-[#d4af37]/20 border border-[#d4af37]/40 text-[#f7d774] text-sm flex items-center justify-center font-bold">5</span>
          <span>Minors &amp; Children's Privacy</span>
        </h2>

        <p class="text-slate-300 text-sm leading-relaxed">
          While Kali Hotel &amp; Restaurant is a welcoming multi-cuisine family destination hosting birthday parties and children's celebrations in private cabins, our digital website is directed towards adults and general audiences. We do not knowingly solicit, harvest, or store personal information from minors under the age of 18.
        </p>
      </section>

      <!-- Section 6: Direct Contact for Privacy Matters -->
      <section class="glass-panel p-6 sm:p-8 rounded-2xl border-2 border-[#d4af37]/50 shadow-2xl bg-gradient-to-br from-[#101a36] to-[#0b1329]">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <h2 class="font-serif text-2xl font-bold text-white mb-2">Have Questions About Your Privacy?</h2>
            <p class="text-slate-300 text-sm leading-relaxed max-w-xl">
              If you have any questions regarding our website's data handling, Google Maps integration, or want to speak with management directly, please reach out to us:
            </p>
            <div class="mt-4 space-y-1.5 text-xs text-slate-400">
              <p><strong class="text-white">Physical Location:</strong> <%= restaurant.address %>, Madhesh Province, Nepal</p>
              <p><strong class="text-white">Operating Hours:</strong> <%= restaurant.hours %></p>
              <p><strong class="text-white">Direct Phone:</strong> <%= restaurant.phone %></p>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto shrink-0">
            <a href="tel:<%= restaurant.phoneRaw %>" 
               class="w-full sm:w-auto px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs border border-slate-700 flex items-center justify-center gap-2 transition-colors">
              <svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
