<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | Kali Hotel & Restaurant Janakpur</title>
  <link rel="icon" type="image/jpeg" href="/images/logo_kali.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=1.0.3">
</head>
<body class="bg-[#0b1329] text-slate-100 min-h-screen flex flex-col justify-between antialiased">
  
  <!-- Minimal Header -->
  <header class="py-6 px-4 border-b border-slate-800">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 shrink-0 rounded-full overflow-hidden border-2 border-[#d4af37]" style="width: 40px; height: 40px; min-width: 40px; min-height: 40px; max-width: 40px; max-height: 40px;">
          <img src="/images/logo_kali.jpg" alt="Kali Hotel Logo" width="40" height="40" class="w-full h-full object-cover" style="width: 40px; height: 40px; object-fit: cover;">
        </div>
        <span class="font-serif text-xl font-bold text-white">Kali Hotel &amp; Restaurant</span>
      </a>
      <a href="tel:<%= restaurant.phoneRaw %>" class="text-xs text-[#d4af37] font-semibold flex items-center gap-1.5 hover:underline">
        <span>Call: <%= restaurant.phone %></span>
      </a>
    </div>
  </header>

  <!-- 404 Body -->
  <main class="flex-1 flex items-center justify-center px-4 py-16 text-center">
    <div class="max-w-md mx-auto glass-panel p-8 sm:p-10 rounded-2xl border border-[#d4af37]/30 shadow-2xl">
      <span class="font-serif text-6xl sm:text-7xl font-extrabold gold-gradient-text block mb-3">404</span>
      <h1 class="text-2xl font-bold text-white mb-3">Table Not Found</h1>
      <p class="text-slate-300 text-sm leading-relaxed mb-8">
        The page you are looking for has been moved or doesn't exist. Come join us at our main dining hall for delicious biryani, momos, and warm hospitality.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="w-full sm:w-auto px-6 py-3 rounded-xl gold-gradient-bg text-[#0b1329] font-bold text-xs uppercase tracking-wider hover:brightness-110 transition-all">
          Return to Home
        </a>
        <a href="https://wa.me/<%= restaurant.whatsappNumber %>" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs border border-slate-700 transition-colors">
          Contact on WhatsApp
        </a>
      </div>
    </div>
  </main>

  <!-- Minimal Footer -->
  <footer class="py-6 px-4 border-t border-slate-800 text-center text-xs text-slate-500">
    <p>&copy; <%= currentYear %> <%= restaurant.name %>. Janakpur Dham, Nepal.</p>
  </footer>

</body>
</html>
