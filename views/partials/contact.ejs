<!-- Contact, Location & Google Map Section -->
<section id="location" class="py-24 relative bg-[#0b1329] border-t border-slate-800/80 overflow-hidden">

  <!-- Ambient background glow -->
  <div
    class="absolute left-1/2 -top-40 -translate-x-1/2 w-[700px] h-[350px] bg-[#d4af37]/5 rounded-full filter blur-[120px] pointer-events-none">
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-[#d4af37]/40 text-xs text-[#d4af37] font-semibold uppercase tracking-wider mb-4 shadow-md">
        <span>Visit &amp; Connect With Us</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-6">
        Find Us in <span class="gold-gradient-text">Janakpur Dham</span>
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Conveniently situated along the Ring Road in Janakpur Dham, Kali Hotel &amp; Restaurant is easily accessible
        with spacious parking and warm hospitality awaiting you.
      </p>
    </div>

    <!-- Contact & Map Split Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">

      <!-- Left Column: Information Cards (No Inquiry Form, Direct Connect) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6">

        <!-- Address & Directions Card -->
        <div class="glass-panel p-6 sm:p-8 rounded-2xl glass-panel-hover">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 rounded-xl bg-[#d4af37]/15 border border-[#d4af37]/30 text-[#d4af37] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="flex-1">
              <span class="text-xs font-bold text-[#d4af37] uppercase tracking-wider">Our Address</span>
              <h3 class="text-base sm:text-lg font-bold text-white mt-1">Kali Hotel &amp; Restaurant</h3>
              <p class="text-slate-300 text-sm mt-1 leading-relaxed">
                <%= restaurant.address %>
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <a href="<%= restaurant.googleMapsUrl %>" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#d4af37]/15 hover:bg-[#d4af37]/25 text-[#f7d774] text-xs font-semibold border border-[#d4af37]/40 transition-colors">
                  <span>Open in Google Maps</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Phone & Direct Calling Card -->
        <div class="glass-panel p-6 sm:p-8 rounded-2xl glass-panel-hover">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 rounded-xl bg-[#d4af37]/15 border border-[#d4af37]/30 text-[#d4af37] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="flex-1">
              <span class="text-xs font-bold text-[#d4af37] uppercase tracking-wider">Direct Contact &amp;
                Bookings</span>
              <p class="text-xl sm:text-2xl font-serif font-bold text-white mt-1">
                <a href="tel:<%= restaurant.phoneRaw %>" class="hover:text-[#f7d774] transition-colors">
                  <%= restaurant.phone %>
                </a>
              </p>
              <p class="text-slate-400 text-xs mt-1">
                No inquiry forms needed — call or WhatsApp us directly for instantaneous table reservations, party
                setups, and takeaway orders.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <a href="tel:<%= restaurant.phoneRaw %>"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-md transition-all active:scale-95">
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                    <path
                      d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
                  </svg>
                  <span>Call Now</span>
                </a>

                <button type="button" onclick="copyPhoneNumber('<%= restaurant.phoneRaw %>')"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors">
                  <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span>Copy Number</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Hours & Facebook Connection Card -->
        <div class="glass-panel p-6 sm:p-8 rounded-2xl glass-panel-hover">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

            <!-- Opening Hours -->
            <div>
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-[#d4af37]" fill="none" stroke="currentColor" stroke-width="2"
                  viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-bold text-[#d4af37] uppercase tracking-wider">Opening Hours</span>
              </div>
              <p class="text-sm font-semibold text-white">Sunday – Saturday</p>
              <p class="text-xs text-slate-300 mt-0.5">8:00 AM – 10:00 PM</p>
              <span
                class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                Open Everyday
              </span>
            </div>

            <!-- Facebook Community -->
            <div>
              <div class="flex items-center gap-2 mb-2">
                <svg class="w-5 h-5 text-blue-400 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
                <span class="text-xs font-bold text-[#d4af37] uppercase tracking-wider">Social Media</span>
              </div>
              <p class="text-sm font-semibold text-white">Facebook Community</p>
              <p class="text-xs text-slate-300 mt-0.5">Follow for daily updates &amp; food highlights</p>
              <a href="<%= restaurant.facebookUrl %>" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 mt-2 text-xs text-[#d4af37] hover:text-[#f7d774] font-medium underline">
                <span>Visit Facebook Page</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>

          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Embedded Google Maps -->
      <div class="lg:col-span-7 relative flex flex-col">
        <div
          class="relative w-full h-full min-h-[460px] rounded-2xl overflow-hidden border-2 border-[#d4af37]/30 shadow-2xl bg-slate-900 group">

          <!-- Google Map iframe -->
          <iframe title="Kali Hotel & Restaurant Location Map Janakpur Dham" src="<%= restaurant.mapEmbedUrl %>"
            class="w-full h-full min-h-[460px] border-0 filter contrast-105 brightness-95" allowfullscreen=""
            loading="lazy" referrerpolicy="no-referrer-when-downgrade">
          </iframe>

          <!-- Map Overlay Pill -->
          <div
            class="absolute top-4 left-4 right-4 sm:right-auto max-w-sm p-3.5 rounded-xl bg-slate-950/90 border border-[#d4af37]/40 backdrop-blur-md shadow-xl flex items-center gap-3">
            <div
              class="w-9 h-9 rounded-full bg-[#d4af37] text-[#0b1329] flex items-center justify-center font-serif font-bold text-sm shrink-0">
              KH
            </div>
            <div>
              <p class="text-xs font-bold text-white">Kali Hotel &amp; Restaurant</p>
              <p class="text-[11px] text-slate-300">PWRG+3JF, Ring Rd, Janakpur Dham</p>
            </div>
            <a href="<%= restaurant.googleMapsUrl %>" target="_blank" rel="noopener noreferrer"
              class="ml-auto px-2.5 py-1 rounded bg-[#d4af37]/20 hover:bg-[#d4af37]/40 text-[#f7d774] text-[11px] font-bold border border-[#d4af37]/30 transition-colors shrink-0">
              Directions
            </a>
          </div>


        </div>
      </div>

    </div>

  </div>
</section>