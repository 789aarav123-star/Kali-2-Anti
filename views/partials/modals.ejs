<!-- Quick WhatsApp Reservation & Inquiry Modal -->
<div id="whatsapp-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" role="dialog"
  aria-modal="true" aria-labelledby="modal-title">
  <!-- Backdrop -->
  <div id="whatsapp-modal-backdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm transition-opacity"></div>

  <!-- Modal Dialog -->
  <div
    class="relative w-full max-w-lg rounded-2xl bg-[#0d162e] border border-[#d4af37]/40 shadow-2xl p-6 sm:p-8 z-10 max-h-[90vh] overflow-y-auto">

    <!-- Modal Close Button -->
    <button type="button" id="close-whatsapp-modal"
      class="absolute top-4 right-4 p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-[#d4af37]"
      aria-label="Close modal">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="flex items-center gap-3 mb-5">
      <div
        class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
      </div>
      <div>
        <h3 id="modal-title" class="text-lg font-bold text-white">Instant WhatsApp Connect</h3>
        <p class="text-xs text-slate-400">Zero booking friction — send your details straight to Kali Hotel</p>
      </div>
    </div>

    <!-- Booking Type Selector -->
    <div class="mb-5">
      <label class="block text-xs font-bold text-[#d4af37] uppercase tracking-wider mb-2">Select Purpose</label>
      <div class="grid grid-cols-3 gap-2">
        <label class="cursor-pointer">
          <input type="radio" name="booking-type" value="table" checked class="peer sr-only">
          <div
            class="p-2.5 text-center rounded-xl bg-slate-900 border border-slate-700 peer-checked:border-[#d4af37] peer-checked:bg-[#d4af37]/15 peer-checked:text-[#f7d774] transition-all">
            <span class="block text-xs font-semibold">Table Dining</span>
          </div>
        </label>

        <label class="cursor-pointer">
          <input type="radio" name="booking-type" value="celebration" class="peer sr-only">
          <div
            class="p-2.5 text-center rounded-xl bg-slate-900 border border-slate-700 peer-checked:border-[#d4af37] peer-checked:bg-[#d4af37]/15 peer-checked:text-[#f7d774] transition-all">
            <span class="block text-xs font-semibold">Cabin / Party</span>
          </div>
        </label>

        <label class="cursor-pointer">
          <input type="radio" name="booking-type" value="takeaway" class="peer sr-only">
          <div
            class="p-2.5 text-center rounded-xl bg-slate-900 border border-slate-700 peer-checked:border-[#d4af37] peer-checked:bg-[#d4af37]/15 peer-checked:text-[#f7d774] transition-all">
            <span class="block text-xs font-semibold">Takeaway</span>
          </div>
        </label>
      </div>
    </div>

    <!-- Guest Count Selection -->
    <div class="mb-4">
      <label for="wa-guests" class="block text-xs font-bold text-slate-300 mb-1.5">Number of Guests</label>
      <select id="wa-guests"
        class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-[#d4af37] focus:ring-1 focus:ring-[#d4af37] outline-none transition-colors">
        <option value="2 Guests">2 Guests (Couple / Pair)</option>
        <option value="3 to 5 Guests" selected>3 to 5 Guests (Family / Friends)</option>
        <option value="6 to 10 Guests">6 to 10 Guests (Small Gathering)</option>
        <option value="12+ Guests">12+ Guests (Birthday / Anniversary Party)</option>
        <option value="20+ Guests (Full Cabin Booking)">20+ Guests (Private Cabin Group)</option>
      </select>
    </div>

    <!-- Special Request / Occasion -->
    <div class="mb-5">
      <label for="wa-occasion" class="block text-xs font-bold text-slate-300 mb-1.5">Special Request or Celebration
        (Optional)</label>
      <input type="text" id="wa-occasion" placeholder="e.g., Birthday surprise, balloon decor, table near window"
        class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm placeholder-slate-500 focus:border-[#d4af37] focus:ring-1 focus:ring-[#d4af37] outline-none transition-colors">
    </div>

    <!-- WhatsApp Message Preview -->
    <div class="mb-6 p-3.5 rounded-xl bg-slate-950/80 border border-slate-800 text-xs text-slate-300">
      <div class="flex items-center justify-between text-slate-400 mb-1.5">
        <span class="font-medium text-[11px] uppercase tracking-wider text-[#d4af37]">WhatsApp Message Preview:</span>
        <span class="text-[10px]">Opens official app</span>
      </div>
      <p id="wa-preview-text" class="italic text-slate-200 font-light leading-relaxed"></p>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <a id="wa-send-btn" href="https://wa.me/<%= restaurant.whatsappNumber %>" target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm tracking-wide shadow-lg shadow-emerald-950/40 transition-all active:scale-95">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>Open in WhatsApp</span>
      </a>

      <a href="tel:<%= restaurant.phoneRaw %>"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm border border-slate-700 transition-colors shrink-0">
        <svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Directly</span>
      </a>
    </div>

  </div>
</div>

<!-- Image Lightbox Modal -->
<div id="image-lightbox" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" role="dialog"
  aria-modal="true">
  <div class="lightbox-backdrop fixed inset-0 bg-slate-950/90 backdrop-blur-md"></div>

  <div class="relative z-10 max-w-4xl max-h-[90vh] flex flex-col items-center">
    <button type="button" id="close-lightbox"
      class="absolute -top-12 right-0 p-2 text-slate-300 hover:text-white bg-slate-900/80 rounded-full border border-slate-700 transition-colors"
      aria-label="Close image lightbox">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <img id="lightbox-img" src="" alt="Kali Hotel Preview"
      class="max-w-full max-h-[75vh] object-contain rounded-xl border border-[#d4af37]/30 shadow-2xl">
    <p id="lightbox-caption" class="text-sm font-medium text-slate-300 mt-3 text-center px-4"></p>
  </div>
</div>

<!-- Sticky Mobile Action Bar (< md screens) -->
<aside
  class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-slate-950/95 border-t border-[#d4af37]/30 px-4 py-3 backdrop-blur-lg shadow-2xl"
  aria-label="Mobile Quick Actions">
  <div class="grid grid-cols-2 gap-3">
    <a href="tel:<%= restaurant.phoneRaw %>"
      class="inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-slate-800 text-white font-bold text-xs uppercase tracking-wider border border-slate-700 active:scale-95 transition-transform">
      <svg class="w-4 h-4 text-[#d4af37]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Call Now</span>
    </a>

    <a href="https://wa.me/<%= restaurant.whatsappNumber %>?text=Hello%20Kali%20Hotel!%20I%20would%20like%20to%20reserve%20a%20table%20/%20cabin%20at%20Janakpur%20Dham."
      target="_blank" rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-gradient-to-r from-[#d4af37] to-[#aa851e] text-[#0b1329] font-bold text-xs uppercase tracking-wider shadow-md shadow-[#d4af37]/30 active:scale-95 transition-transform">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
      </svg>
      <span>WhatsApp Us</span>
    </a>
  </div>
</aside>