<!-- Hero Section with counter.jpg background -->
<section id="top" class="relative min-h-[92vh] flex items-center justify-center pt-24 pb-16 overflow-hidden">
  
  <!-- Background Image with Multi-layer Atmospheric Gradient -->
  <div class="absolute inset-0 z-0">
    <img src="/images/counter.jpg" 
         alt="Kali Hotel Bar and Lounge Ambience" 
         class="w-full h-full object-cover object-center filter brightness-50 scale-105 transform motion-safe:animate-[pulse_10s_ease-in-out_infinite]">
    
    <!-- Deep Navy & Gold Ambient Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0b1329] via-[#0b1329]/80 to-[#0b1329]/50"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0b1329]/95 via-transparent to-[#0b1329]/90"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-amber-500/10 via-transparent to-[#0b1329]/80"></div>
  </div>

  <!-- Hero Content Container -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Rating & Verification Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/80 border border-[#d4af37]/40 shadow-xl mb-6 backdrop-blur-md">
      <div class="flex items-center text-amber-400">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <span class="ml-1 text-sm font-bold text-amber-300">4.0</span>
      </div>
      <span class="text-xs text-slate-400">|</span>
      <span class="text-xs font-medium text-slate-300">Google Verified</span>
      <span class="text-xs text-amber-400 font-semibold">(167+ Reviews)</span>
      <span class="hidden sm:inline text-xs text-slate-400">•</span>
      <span class="hidden sm:inline text-xs text-slate-300">Janakpur Dham</span>
    </div>

    <!-- Main Headings -->
    <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white mb-6 leading-tight">
      Attractive Ambience &amp; <br class="hidden sm:block">
      <span class="gold-gradient-text">Mouth Watering Cuisine</span>
    </h1>

    <!-- Official Description Quote -->
    <div class="max-w-3xl mx-auto mb-10">
      <p class="text-base sm:text-lg md:text-xl text-slate-200 leading-relaxed font-light italic bg-slate-900/60 p-5 rounded-2xl border border-slate-800/80 shadow-2xl backdrop-blur-sm">
        &ldquo;<%= restaurant.description %>&rdquo;
      </p>
    </div>

    <!-- Direct Action Buttons (Zero friction - Direct Phone & WhatsApp) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto sm:max-w-none">
      
      <!-- WhatsApp Reservation Action -->
      <a href="https://wa.me/9779854025213?text=Hello%20Kali%20Hotel!%20I%20would%20like%20to%20reserve%20a%20table%20/%20cabin%20at%20Janakpur%20Dham." 
         target="_blank" 
         rel="noopener noreferrer"
         class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl gold-gradient-bg text-[#0b1329] font-bold text-sm uppercase tracking-wider btn-gold-glow hover:brightness-110 active:scale-95 transition-all duration-200">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Book on WhatsApp</span>
      </a>

      <!-- Direct Phone Call Action -->
      <a href="tel:+9779854025213" 
         class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-white font-semibold text-sm border border-[#d4af37]/40 hover:border-[#d4af37] shadow-xl transition-all duration-200">
        <svg class="w-5 h-5 text-[#d4af37]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
        <span>Call: +977 9854025213</span>
      </a>

      <!-- Quick Message Builder Button -->
      <button type="button" 
              class="open-whatsapp-modal w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-slate-800/60 hover:bg-slate-800 text-[#f7d774] font-medium text-sm border border-slate-700/80 transition-all duration-200"
              data-type="table">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span>Instant Booking Assistant</span>
      </button>

    </div>

    <!-- Quick Highlights Strip -->
    <div class="mt-14 pt-8 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-4 text-left">
      <div class="p-3 rounded-lg bg-slate-900/50 border border-slate-800">
        <p class="text-xs text-[#d4af37] font-semibold uppercase tracking-wider">Multi-Cuisine</p>
        <p class="text-xs text-slate-300 mt-1">Nepali, Tandoori, Chinese, Thai &amp; Indian</p>
      </div>
      <div class="p-3 rounded-lg bg-slate-900/50 border border-slate-800">
        <p class="text-xs text-[#d4af37] font-semibold uppercase tracking-wider">Cabin Facility</p>
        <p class="text-xs text-slate-300 mt-1">Private dining &amp; birthday party cabins</p>
      </div>
      <div class="p-3 rounded-lg bg-slate-900/50 border border-slate-800">
        <p class="text-xs text-[#d4af37] font-semibold uppercase tracking-wider">Wallet Friendly</p>
        <p class="text-xs text-slate-300 mt-1">Delicious meals from Rs 1 – 500</p>
      </div>
      <div class="p-3 rounded-lg bg-slate-900/50 border border-slate-800">
        <p class="text-xs text-[#d4af37] font-semibold uppercase tracking-wider">Open Daily</p>
        <p class="text-xs text-slate-300 mt-1">9:00 AM – 10:30 PM (All 7 Days)</p>
      </div>
    </div>

  </div>

</section>
