<!-- Footer Section -->
<footer class="bg-slate-950 border-t border-[#d4af37]/20 pt-16 pb-12 text-slate-300 relative overflow-hidden">

  <!-- Subtle decorative light aura -->
  <div
    class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[250px] bg-[#d4af37]/5 rounded-full filter blur-[100px] pointer-events-none">
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800">

      <!-- Brand & Description (5 cols) -->
      <div class="lg:col-span-5 space-y-5">
        <div class="flex items-center gap-3">
          <div
            class="w-12 h-12 shrink-0 rounded-full overflow-hidden border-2 border-[#d4af37] shadow-lg shadow-[#d4af37]/20"
            style="width: 48px; height: 48px; min-width: 48px; min-height: 48px; max-width: 48px; max-height: 48px;">
            <img src="/images/logo_kali.jpg" alt="Kali Hotel & Restaurant Logo" width="48" height="48"
              class="w-full h-full object-cover" style="width: 48px; height: 48px; object-fit: cover;">
          </div>
          <div>
            <span class="font-serif text-2xl font-bold tracking-wide text-white block">
              Kali Hotel
            </span>
            <span class="text-xs uppercase tracking-widest text-[#d4af37] font-semibold">
              &amp; Restaurant · Janakpur Dham
            </span>
          </div>
        </div>

        <p class="text-slate-400 text-sm leading-relaxed max-w-md">
          <%= restaurant.description %>
        </p>

        <!-- Social Proof Pill -->
        <div
          class="inline-flex items-center gap-3 px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300">
          <div class="flex text-amber-400">
            <% for(let i=0; i<4; i++) { %>
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <% } %>
          </div>
          <span class="font-bold text-white">4.0 / 5.0</span>
          <span class="text-slate-500">·</span>
          <span>167+ Reviews on Google</span>
        </div>
      </div> <!-- Quick Links (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="text-xs uppercase font-bold text-[#d4af37] tracking-wider">Quick Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/#about" class="hover:text-[#f7d774] transition-colors">About &amp; Lounge</a></li>
          <li><a href="/#menu" class="hover:text-[#f7d774] transition-colors">Our Signature Menu</a></li>
          <li><a href="/#celebrations" class="hover:text-[#f7d774] transition-colors">Celebrations &amp; Cabins</a></li>
          <li><a href="/#reviews" class="hover:text-[#f7d774] transition-colors">Verified Reviews</a></li>
          <li><a href="/#location" class="hover:text-[#f7d774] transition-colors">Location &amp; Map</a></li>
          <li><a href="/privacy-policy"
              class="hover:text-[#f7d774] text-[#d4af37]/90 font-medium transition-colors">Privacy Policy &amp;
              Trackers</a></li>
        </ul>
      </div>

      <!-- Cuisines (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="text-xs uppercase font-bold text-[#d4af37] tracking-wider">Multi-Cuisine</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
            <span>Nepali &amp; Mithila</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
            <span>Tandoori &amp; Sizzlers</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
            <span>Dum Biryani</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
            <span>Chinese &amp; Thai</span>
          </li>
          <li class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
            <span>North Indian curries</span>
          </li>
        </ul>
      </div>

      <!-- Direct Contact & Socials (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs uppercase font-bold text-[#d4af37] tracking-wider">Direct Connect</h4>

        <div class="space-y-2.5 text-xs text-slate-300">
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#d4af37] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>
              <%= restaurant.address %>
            </span>
          </div>

          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#d4af37] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:<%= restaurant.phoneRaw %>" class="hover:text-[#f7d774] font-medium transition-colors">
              <%= restaurant.phone %>
            </a>
          </div>

          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 fill-current" viewBox="0 0 24 24">
              <path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
            <a href="https://wa.me/<%= restaurant.whatsappNumber %>" target="_blank" rel="noopener noreferrer"
              class="hover:text-emerald-300 font-medium transition-colors">
              WhatsApp Chat Active
            </a>
          </div>
        </div>

        <!-- Social Icons -->
        <div class="pt-2 flex items-center gap-3">
          <a href="<%= restaurant.facebookUrl %>" target="_blank" rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-blue-500 hover:bg-blue-600/20 flex items-center justify-center transition-all"
            aria-label="Kali Hotel Facebook">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>

          <a href="<%= restaurant.googleMapsUrl %>" target="_blank" rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-[#d4af37] hover:bg-[#d4af37]/20 flex items-center justify-center transition-all"
            aria-label="Kali Hotel Google Maps Profile">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </a>
        </div>

      </div>

    </div>

    <!-- Bottom Copyright & Credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        &copy; <%= currentYear %>
          <%= restaurant.name %>. Naming Rights reserved. Janakpur Dham, Madhesh Province, Nepal.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a href="/privacy-policy" class="text-slate-400 hover:text-[#d4af37] underline transition-colors">
          Privacy Policy &amp; Trackers
        </a>
        <span>•</span>
        <a href="#top" class="text-slate-400 hover:text-[#d4af37] transition-colors flex items-center gap-1">
          <span>Back to Top</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </a>
      </div>
    </div>

  </div>
</footer>